{
  "name": "focus-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A colorful, local-first focus tracker: time your tasks, journal your day, and watch your streaks grow.",
  "license": "MIT",
  "homepage": "https://focus-tracker-lemon.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/somcpp/focus-tracker.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.focustracker.island",
    "productName": "Focus Tracker Island",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
